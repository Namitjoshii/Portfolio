# Copy this file to ".env" for local testing, then fill in your own key.
# The real ".env" must NEVER be committed (it is listed in .gitignore).
#
# IMPORTANT: do not add a VITE_ prefix to these names. Anything starting with
# VITE_ is copied into the public website code and anyone could read it.

GEMINI_API_KEY=
# Optional: change the model without editing code
# GEMINI_MODEL=gemini-2.5-flash-lite
